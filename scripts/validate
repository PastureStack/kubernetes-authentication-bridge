#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "${repo_root}"

unformatted=$(find . -path './.git' -prune -o -name '*.go' -type f -print0 | xargs -0 gofmt -l)
if [ -n "${unformatted}" ]; then
    printf '%s\n' "${unformatted}" >&2
    exit 1
fi
go vet -mod=mod ./...
test "$(go list -mod=mod -m all | wc -l)" -eq 1
test ! -e vendor
test ! -e vendor.conf
grep -Fx 'go 1.26.0' go.mod >/dev/null
grep -Fx 'toolchain go1.27.3' go.mod >/dev/null
grep -Fx 'ARG GO_VERSION=1.27.3' Dockerfile.dapper >/dev/null
grep -Fx '          GO_VERSION: 1.27.3' .github/workflows/codeql-verification.yml >/dev/null
grep -Fx 'ARG DOCKER_VERSION=29.9.2' Dockerfile.dapper >/dev/null
grep -Fx 'ARG DOCKER_LINUX_AMD64_SHA256=9ac225999fd5e863f7694c728ef23d480616b1e5639328fa309befd4243d69eb' Dockerfile.dapper >/dev/null
grep -F 'docker:29.9.2-cli@sha256:000bb62ff495f986c9f5578eb67cc2cb98b91138eda81d7762d5371eb8a497fe' Dockerfile.dapper >/dev/null
grep -F 'golang:1.27.3-bookworm@sha256:972b4110ba0f47539a975c31e52c64765e1ff19f2d74469ae4a595c6676e80a5 AS buildx-plugin' Dockerfile.dapper >/dev/null
grep -F 'golang.org/x/net@v0.60.0 golang.org/x/mod@v0.41.0 google.golang.org/grpc@v1.83.2' Dockerfile.dapper >/dev/null
grep -F 'ubuntu:26.04@sha256:2260313b31c8c011cd2eebe728008efac1b3982be73eb71348ea2648d2c0e09b' Dockerfile.dapper >/dev/null
grep -F 'gcr.io/distroless/static-debian12@sha256:4b2a093ef4649bccd586625090a3c668b254cfe180dee54f4c94f3e9bd7e381e' package/Dockerfile >/dev/null
grep -Fx "UBUNTU_APT_SNAPSHOT='20260808T000000Z'" package/ubuntu-apt.lock >/dev/null
scan_paths=(README.md SECURITY.md COMPATIBILITY.md Dockerfile.dapper Makefile package scripts)
if [ -d .github ]; then
    scan_paths+=(.github)
fi
if grep -R -Eiq 'v[0-9]+\.[0-9]+\.[0-9]+-(pasturestack|rancher)[0-9.]+' "${scan_paths[@]}"; then
    echo BRANDED_VERSION_SUFFIX_PRESENT >&2
    exit 1
fi
for script in scripts/*; do
    bash -n "${script}"
done
VERSION_OVERRIDE=0.0.13
source scripts/version
test "${VERSION}" = 0.0.13
echo KUBERNETES_AUTHENTICATION_BRIDGE_VALIDATION_OK
