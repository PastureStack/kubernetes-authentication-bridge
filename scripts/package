#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
source "${repo_root}/scripts/version"
source_revision=${SOURCE_REVISION:-$(git -C "${repo_root}" rev-parse HEAD)}
if ! [[ "${source_revision}" =~ ^[0-9a-f]{40}$ ]]; then
    echo "SOURCE_REVISION must be the exact full Git commit" >&2
    exit 1
fi
image_name=${IMAGE_NAME:-pasturestack/kubernetes-authentication-bridge}
tag=${TAG:-v${VERSION}}
if ! [[ "${tag}" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "TAG must be a plain numeric semantic version with only the v prefix" >&2
    exit 1
fi
case "${image_name}" in
    *:*) image=${image_name} ;;
    *) image=${image_name}:${tag} ;;
esac

work_dir=$(mktemp -d "${TMPDIR:-/tmp}/pasturestack-auth-bridge-package.XXXXXX")
cleanup() {
    rm -rf -- "${work_dir}"
}
trap cleanup EXIT
cp "${repo_root}/bin/kubernetes-authentication-bridge" "${work_dir}/"
cp "${repo_root}/package/Dockerfile" "${work_dir}/"
cp "${repo_root}/LICENSE" "${repo_root}/SECURITY.md" "${repo_root}/ORIGIN.md" \
    "${repo_root}/COMPATIBILITY.md" "${work_dir}/"

DOCKER_BUILDKIT=1 docker build \
    --network "${DOCKER_BUILD_NETWORK:-host}" \
    --build-arg "IMAGE_VERSION=${VERSION}" \
    --build-arg "SOURCE_REVISION=${source_revision}" \
    --tag "${image}" "${work_dir}"
mkdir -p "${repo_root}/dist"
printf '%s\n' "${image}" > "${repo_root}/dist/images"
printf 'Built %s\n' "${image}"
