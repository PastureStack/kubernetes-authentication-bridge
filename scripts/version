#!/usr/bin/env bash
set -euo pipefail

candidate=${VERSION_OVERRIDE:-}
if [ -z "${candidate}" ]; then
    mapfile -t release_tags < <(git tag --points-at HEAD --list 'v[0-9]*.[0-9]*.[0-9]*' | LC_ALL=C sort -V)
    if [ "${#release_tags[@]}" -gt 1 ]; then
        echo "multiple numeric release tags point at HEAD" >&2
        exit 1
    fi
    candidate=${release_tags[0]:-0.0.0}
fi
candidate=${candidate#v}
if ! [[ "${candidate}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "VERSION_OVERRIDE must be a plain numeric semantic version such as 0.0.12" >&2
    exit 1
fi
VERSION=${candidate}
export VERSION
